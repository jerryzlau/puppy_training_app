// Copy to include/secrets.h (gitignored) and fill in.
#pragma once
#define WIFI_SSID     "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"
// Mock-only token (the mock accepts anything). The LIVE build never uses this:
// its token is minted by the server during pairing and stored in flash.
#define BIRU_DEVICE_TOKEN "mock-token"
// Optional: pairing code from the Family page ("add a button pad"). If set, an
// unpaired board claims it on boot. Otherwise type `claim <code>` in the serial
// monitor. Codes are single-use and expire after 15 min — remove it after pairing.
// #define BIRU_CLAIM_CODE "K7F3QM"
